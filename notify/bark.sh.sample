#!/usr/bin/env bash
# Bark (iOS) notifier for Fluid.
#
# Install it, then put your own device key below:
#
#   cp ~/.fluid/notify/bark.sh.sample ~/.fluid/notify.sh
#   chmod +x ~/.fluid/notify.sh
#   ~/.fluid/fluid.sh notify-test
#
# Fluid runs this script with CP_EVENT, CP_MESSAGE and CP_HOST set.

set -u

BARK_KEY="your-device-key"
BARK_SERVER="https://api.day.app"

curl -fsS -o /dev/null \
    --max-time 15 \
    --data-urlencode "title=Fluid on $CP_HOST" \
    --data-urlencode "body=$CP_MESSAGE" \
    --data-urlencode "group=fluid" \
    "$BARK_SERVER/$BARK_KEY"
